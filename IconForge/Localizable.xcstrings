    "%@ px is too small for ICNS (1024 px or more required). ICO can still be created." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px ist für ICNS zu klein (mindestens 1024 px erforderlich). ICO kann trotzdem erstellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px es demasiado pequeño para ICNS (se necesitan 1024 px o más). Aun así, se puede crear el ICO."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px, c’est trop petit pour l’ICNS (1024 px ou plus requis). L’ICO peut tout de même être créé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px è troppo piccolo per l’ICNS (sono necessari almeno 1024 px). L’ICO può comunque essere creato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px なので ICNS は作成できません（1024 px 以上が必要）。ICO は作成できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px é pequeno demais para o ICNS (são necessários 1024 px ou mais). O ICO ainda pode ser criado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px 无法制作 ICNS（需要 1024 px 以上）。仍可制作 ICO。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ px 無法製作 ICNS（需要 1024 px 以上）。仍可製作 ICO。"
          }
        }
      }
    },
